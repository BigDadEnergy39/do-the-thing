# Release signing config for Do The Thing.
#
# Copy this file to `android/keystore.properties` (which is gitignored) and fill
# in your real values. build.gradle reads it to sign release builds. If this file
# is absent, release builds fall back to DEBUG signing and must not be shipped.
#
# 1. Generate a release keystore (once — keep the .jks and these passwords safe;
#    losing them means you can never ship a signed update again):
#
#    keytool -genkeypair -v \
#      -storetype PKCS12 \
#      -keystore dtt-release.jks \
#      -alias dtt-release \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Move dtt-release.jks somewhere outside the repo (or anywhere git ignores),
#    and point storeFile at it below. A relative path is resolved against the
#    android/ directory; an absolute path is used as-is.
#
# Note: for F-Droid, the F-Droid server signs the published APK with its own key,
# so this config governs only your own direct/sideload builds.

storeFile=../dtt-release.jks
storePassword=CHANGE_ME
keyAlias=dtt-release
keyPassword=CHANGE_ME
